{
  "name": "acf/cta-section",
  "title": "CTA Section",
  "description": "Centered call-to-action section with two buttons.",
  "category": "yonksteam",
  "icon": "megaphone",
  "keywords": ["cta", "call to action", "buttons"],
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  },
  "supports": {
    "align": ["full"],
    "mode": true,
    "jsx": false
  },
  "fields": [
    {
      "key": "field_cta_headline",
      "label": "Headline",
      "name": "headline",
      "type": "text",
      "required": true
    },
    {
      "key": "field_cta_body",
      "label": "Body",
      "name": "body",
      "type": "wysiwyg",
      "tabs": "visual",
      "media_upload": false
    },
    {
      "key": "field_cta_cta_primary",
      "label": "Primary CTA",
      "name": "cta_primary",
      "type": "link"
    },
    {
      "key": "field_cta_cta_secondary",
      "label": "Secondary CTA",
      "name": "cta_secondary",
      "type": "link"
    },
    {
      "key": "field_cta_background_color",
      "label": "Background Color",
      "name": "background_color",
      "type": "select",
      "required": true,
      "default_value": "default",
      "choices": {
        "default": "Default",
        "dark": "Dark",
        "warm": "Warm"
      }
    }
  ]
}