              "settings": {
                "html": "<div class=\"hero-interior\"><div class=\"hero-interior__inner\"><div class=\"hero-interior__eyebrow\">For CPAs &amp; Financial Advisors</div><h1 class=\"hero-interior__headline\">You built a practice that clients trust. Now you need a way out that doesn't betray them.</h1><p class=\"hero-interior__subheadline\">Whether you want to rebuild the practice around the life you want, or sell it to the people who trust you most — we'll show you how.</p></div></div>"
              },
              "elements": []
            }
          ]
