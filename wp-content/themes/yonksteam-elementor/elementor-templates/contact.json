              "id": "875bb64",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"section\"><div class=\"section__inner--narrow\"><form class=\"contact-form reveal\"><div class=\"contact-form__row\"><label>\n            Your Name\n            <input type=\"text\" placeholder=\"First &amp; last name\" required></label><label>\n            Email\n            <input type=\"email\" placeholder=\"your@email.com\" required></label></div><label>\n          Phone <span style=\"font-weight:400;color:var(--muted);\">(optional)</span><input type=\"tel\" placeholder=\"(555) 123-4567\"></label><label>\n          Tell us about your practice and what's on your mind\n          <textarea placeholder=\"What's your practice look like? What's the thing that finally made you say 'I need to talk to someone'?\"></textarea></label><button type=\"submit\" class=\"btn btn--primary btn--arrow\" style=\"font-size:1.1rem;padding:1rem 2.5rem;\">Send →</button></form></div></div>"
              },
