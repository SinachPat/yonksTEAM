        {
          "id": "plan-subheadline",
          "type": "text",
          "settings": {
            "editor": "<p style='text-align: center; font-style: italic;'>Three steps. Not a program. A path.</p>",
            "text_color": "#2563eb",
            "typography_typography": "custom",
            "typography_font_family": "Playfair Display",
            "typography_font_size": {
              "size": "20",
              "unit": "px"
            }
          }
        }
      ]
