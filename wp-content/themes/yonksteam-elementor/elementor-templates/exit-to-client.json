              "id": "875bb64",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div class=\"section section--light\"><div class=\"section__inner\"><h2 class=\"section__headline section__headline--center\">Traditional exits leave everyone worse off.</h2><div class=\"comparison\"><div class=\"comparison__col comparison__col--traditional\"><h3 class=\"comparison__label\">Traditional Exit</h3><ul class=\"comparison__list\"><li class=\"comparison__item\">Sold to the highest bidder</li><li class=\"comparison__item\">Clients find out from an email address change</li><li class=\"comparison__item\">Thirty years of relationships scattered</li><li class=\"comparison__item\">A stranger runs the practice</li><li class=\"comparison__item\">You get a check and disappear</li></ul></div><div class=\"comparison__col comparison__col--exit\"><h3 class=\"comparison__label\">Exit to Client</h3><ul class=\"comparison__list\"><li class=\"comparison__item\">Sold to the people who know you best</li><li class=\"comparison__item\">Clients become owners</li><li class=\"comparison__item\">Thirty years of relationships deepened</li><li class=\"comparison__item\">The community runs the practice</li><li class=\"comparison__item\">You get a check and a legacy</li></ul></div></div></div></div>"
              },
              "elements": []
            }
          ]
        }
