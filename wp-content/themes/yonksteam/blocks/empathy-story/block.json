{
  "name": "acf/empathy-story",
  "title": "Empathy Story",
  "description": "Two stories side by side, each with title, body, and image.",
  "category": "yonksteam",
  "icon": "format-status",
  "keywords": ["story", "empathy", "narrative"],
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  },
  "supports": {
    "align": ["full"],
    "mode": true,
    "jsx": false
  },
  "fields": [
    {
      "key": "field_empathy_headline",
      "label": "Headline",
      "name": "headline",
      "type": "text",
      "required": true
    },
    {
      "key": "field_empathy_story_1_title",
      "label": "Story 1 Title",
      "name": "story_1_title",
      "type": "text",
      "required": true
    },
    {
      "key": "field_empathy_story_1_body",
      "label": "Story 1 Body",
      "name": "story_1_body",
      "type": "textarea",
      "required": true,
      "new_lines": "wpautop"
    },
    {
      "key": "field_empathy_story_1_image",
      "label": "Story 1 Image",
      "name": "story_1_image",
      "type": "image",
      "return_format": "array",
      "preview_size": "medium"
    },
    {
      "key": "field_empathy_story_2_title",
      "label": "Story 2 Title",
      "name": "story_2_title",
      "type": "text",
      "required": true
    },
    {
      "key": "field_empathy_story_2_body",
      "label": "Story 2 Body",
      "name": "story_2_body",
      "type": "textarea",
      "required": true,
      "new_lines": "wpautop"
    },
    {
      "key": "field_empathy_story_2_image",
      "label": "Story 2 Image",
      "name": "story_2_image",
      "type": "image",
      "return_format": "array",
      "preview_size": "medium"
    }
  ]
}