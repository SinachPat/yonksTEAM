              "settings": {
                "html": "<div class=\"hero-interior\"><div class=\"hero-interior__inner\"><div class=\"hero-interior__content\"><div class=\"hero-interior__eyebrow\">Our Story</div><h1 class=\"hero-interior__headline\">We got out. We can show you how.</h1><p class=\"hero-interior__subheadline\">Jason &amp; Tyler Younker. A married duo who help successful but burned-out professionals get their lives back.</p></div><div class=\"hero-interior__media\"><div class=\"hero-interior__image-placeholder\" style=\"min-height: 360px;\">📸 Jason &amp; Tyler — on the road</div></div></div></div>"
              },
              "elements": []
            }
          ]
        }
      ]
    },
    {
      "id": "9632572",
