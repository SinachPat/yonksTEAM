{
  "name": "acf/authority-block",
  "title": "Authority Block",
  "description": "Three credentials displayed in a grid.",
  "category": "yonksteam",
  "icon": "shield",
  "keywords": ["authority", "credentials", "trust"],
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  },
  "supports": {
    "align": ["full"],
    "mode": true,
    "jsx": false
  },
  "fields": [
    {
      "key": "field_authority_headline",
      "label": "Headline",
      "name": "headline",
      "type": "text",
      "required": true
    },
    {
      "key": "field_authority_credential_1_title",
      "label": "Credential 1 Title",
      "name": "credential_1_title",
      "type": "text",
      "required": true
    },
    {
      "key": "field_authority_credential_1_body",
      "label": "Credential 1 Body",
      "name": "credential_1_body",
      "type": "textarea",
      "required": true,
      "new_lines": "wpautop"
    },
    {
      "key": "field_authority_credential_2_title",
      "label": "Credential 2 Title",
      "name": "credential_2_title",
      "type": "text",
      "required": true
    },
    {
      "key": "field_authority_credential_2_body",
      "label": "Credential 2 Body",
      "name": "credential_2_body",
      "type": "textarea",
      "required": true,
      "new_lines": "wpautop"
    },
    {
      "key": "field_authority_credential_3_title",
      "label": "Credential 3 Title",
      "name": "credential_3_title",
      "type": "text",
      "required": true
    },
    {
      "key": "field_authority_credential_3_body",
      "label": "Credential 3 Body",
      "name": "credential_3_body",
      "type": "textarea",
      "required": true,
      "new_lines": "wpautop"
    }
  ]
}